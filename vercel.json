{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "functions": {
    "server.js": {
      "includeFiles": "dist/client/**",
      "maxDuration": 30
    },
    "api/ai.js": {
      "maxDuration": 30
    }
  },
  "routes": [
    { "src": "/api/ai", "dest": "/api/ai.js" },
    { "src": "/(.*)", "dest": "/server.js" }
  ]
}
