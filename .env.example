# 仅在 Vercel Environment Variables 或本机 .env.local 中填写真实值。
# 不要将任何密钥提交到 Git，也不要使用 NEXT_PUBLIC_ 前缀。
BAILIAN_API_KEY=
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Supabase 登录与学习进度同步。Publishable key 可以发送到浏览器，
# 但 service_role / secret key 绝不能写入前端或提交到 Git。
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_public_key

# 可选：若不填写，则使用服务端内置的模型分流。
# AI_MODEL_LESSON_PRACTICE=qwen-plus
# AI_MODEL_VOICE_DIALOGUE=qwen-max
